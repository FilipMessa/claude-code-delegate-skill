# Record with: vhs demo/delegate.tape   (run from the repository root)
Output demo/delegate.gif

Set Shell "bash"
Set FontSize 18
Set Width 1300
Set Height 680
Set Padding 24
Set Margin 36
Set MarginFill "#181825"
Set BorderRadius 14
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "export PS1=''"
Enter
Show

Type "demo/delegate.sh"
Enter
Sleep 26s
